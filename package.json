{
  "name": "testcontainer-node-lab",
  "version": "1.0.0",
  "description": "Laboratório didático: NestJS + Prisma + PostgreSQL + Vitest + Testcontainers",
  "private": true,
  "scripts": {
    "build": "nest build",
